# === AutoJudge Configuration ===

# Master encryption key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# All other credentials are encrypted and stored in the database.
MASTER_ENCRYPTION_KEY=

# Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=autojudge

# JWT
JWT_SECRET=change-this-to-a-random-secret

# LLM Backend: "anthropic_proxy" or "anthropic_api"
# Used as fallback when no keys are configured in the api_key_pool table.
# For production, add keys via the admin API (encrypted in DB).
LLM_BACKEND=anthropic_proxy

# Anthropic Proxy fallback (when no pool keys available)
ANTHROPIC_PROXY_BASE_URL=https://your-proxy-url.com
ANTHROPIC_PROXY_API_KEY=sk-your-proxy-key

# Anthropic API Direct fallback
# ANTHROPIC_API_KEY=sk-ant-api03-your-key

# Model (default: claude-opus-4-6)
# DEFAULT_MODEL=claude-opus-4-6
# HAIKU_MODEL=claude-haiku-4-5-20251001
