# ═══════════════════════════════════════════════════════
# AutoJudge 配置
# ═══════════════════════════════════════════════════════

# LLM 后端选择: "claude_cli" 或 "anthropic_api"
# claude_cli  → 用 claude -p 调用，不需要 API Key（推荐）
# anthropic_api → 直接调 Anthropic SDK，需要 ANTHROPIC_API_KEY
LLM_BACKEND=claude_cli

# ── claude -p 模式配置 ──
# claude 可执行文件路径（通常就是 "claude"）
CLAUDE_CLI_PATH=claude
# 指定模型（留空则用 Claude Code 默认模型）
# 可选值: sonnet, opus, haiku
CLAUDE_CLI_MODEL=
# 单次调用超时（秒）
CLAUDE_CLI_TIMEOUT=120

# ── Anthropic API 模式配置（仅 LLM_BACKEND=anthropic_api 时需要）──
ANTHROPIC_API_KEY=
DEFAULT_MODEL=claude-sonnet-4-20250514
HAIKU_MODEL=claude-haiku-4-5-20251001

# ── OpenAI API（仅 Memory 系统的向量检索需要，可选）──
# 如果留空，ChromaDB 会用内置的 embedding 模型，不需要外部 API
OPENAI_API_KEY=

# Redis（用户偏好 + 结果缓存 + 限流）
REDIS_URL=redis://localhost:6379/2

# ChromaDB（攻击经验 + 修复模式存储）
CHROMADB_PATH=./data/chromadb

# LangSmith（可观测性，可选）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=autojudge

# 并发控制
MAX_CONCURRENT_DEBATES=5
MAX_CONCURRENT_LLM_CALLS=20

# 调试
DEBUG=false
